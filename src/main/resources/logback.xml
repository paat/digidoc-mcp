<configuration>
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <!-- Bound container-derived messages and prevent forged stderr lines. -->
    <encoder><pattern>%d{HH:mm:ss} %-5level %logger{36} - %replace(%.-2048msg){'[\r\n]', ' '}%n%nopex</pattern></encoder>
  </appender>
  <root level="WARN"><appender-ref ref="STDERR"/></root>
</configuration>
